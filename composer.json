{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/vue-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "inertiajs/inertia-laravel": "^3.2",
        "laravel/chisel": "^0.1.1",
        "laravel/fortify": "^1.37.3",
        "laravel/framework": "^13.23",
        "laravel/tinker": "^3.0.2",
        "laravel/wayfinder": "^0.1.20"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.5",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.10",
        "laravel/boost": "^2.4.13",
        "laravel/pail": "^1.2.7",
        "laravel/pao": "^1.1.2",
        "laravel/pint": "^1.30",
        "laravel/sail": "^1.64",
        "mockery/mockery": "^1.6.12",
        "mrpunyapal/peststan": "^0.2.12",
        "mrpunyapal/rector-pest": "^0.2.17",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.0.1",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "rector/rector": "^2.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "pnpm install",
            "pnpm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "dev:ssr": [
            "pnpm run build:ssr",
            "Composer\\Config::disableProcessTimeout",
            "pnpm exec concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"php artisan inertia:start-ssr\" --names=server,queue,logs,ssr --kill-others"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "update:requirements": [
            "composer bump",
            "pnpm dlx npm-check-updates -u"
        ],
        "lint": [
            "rector",
            "pint --parallel",
            "pnpm run lint"
        ],
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run",
            "pnpm run test:lint"
        ],
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:unit": "XDEBUG_MODE=\"coverage\" pest --parallel --coverage --exactly=100.0",
        "test:types": [
            "phpstan analyse --memory-limit=-1",
            "pnpm run test:types"
        ],
        "test": [
            "@test:lint",
            "@test:type-coverage",
            "@test:types",
            "@test:unit"
        ],
        "ci:check": [
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": []
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
